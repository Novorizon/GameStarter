<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/NavigationLab.Core.csproj" />
    <ProjectReference Include="../Oracle/NavigationLab.Oracle.csproj" />
    <Compile Include="../../../Verification~/TowerDefenseNavigation/Scenarios.cs" Link="FrozenInputs/Scenarios.cs" />
  </ItemGroup>
  <ItemGroup><AssemblyMetadata Include="RepositoryRoot" Value="$(MSBuildThisFileDirectory)../../../" /></ItemGroup>
</Project>
