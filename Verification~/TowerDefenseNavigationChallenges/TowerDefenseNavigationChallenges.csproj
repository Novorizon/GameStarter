<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <NavigationDomainRoot Condition="'$(NavigationDomainRoot)' == ''">$(MSBuildThisFileDirectory)../../Assets/HotUpdate/TowerDefense/Domain</NavigationDomainRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(NavigationDomainRoot)/Configuration.cs" Link="Candidate/Configuration.cs" />
    <Compile Include="$(NavigationDomainRoot)/Navigation/**/*.cs" Link="Candidate/Navigation/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../TowerDefenseNavigation/GeometryChecks.cs" Link="Oracle/GeometryChecks.cs" />
    <Compile Include="../TowerDefenseNavigation/Observations.cs" Link="Oracle/Observations.cs" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>NavigationDomainRoot</_Parameter1>
      <_Parameter2>$(NavigationDomainRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
