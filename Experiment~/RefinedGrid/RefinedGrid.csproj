<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/HotUpdate/TowerDefense/Domain/*.cs" Link="Domain/%(Filename)%(Extension)" />
    <Compile Include="../../Assets/HotUpdate/TowerDefense/Domain/Navigation/**/*.cs" Link="Navigation/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Verification~/TowerDefenseNavigation/Scenarios.cs" Link="Oracle/Scenarios.cs" />
    <Compile Include="../../Verification~/TowerDefenseNavigation/Observations.cs" Link="Oracle/Observations.cs" />
    <Compile Include="../../Verification~/TowerDefenseNavigation/GeometryChecks.cs" Link="Oracle/GeometryChecks.cs" />
  </ItemGroup>
</Project>
